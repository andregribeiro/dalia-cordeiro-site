---
import type { Lang } from '../lib/i18n';
import type { SiteEvent } from '../lib/types';
import { loc } from '../lib/helpers';

interface Props {
  lang: Lang;
  upcoming?: SiteEvent;
  pastRecent?: SiteEvent;
}

const { lang, upcoming, pastRecent } = Astro.props;

const labels = {
  pt: { upcoming: 'Próximo', past: 'Anterior', region: 'Eventos' },
  en: { upcoming: 'Upcoming', past: 'Previous', region: 'Events' },
} as const;

function fmtDate(iso?: string): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (isNaN(+d)) return null;
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const yyyy = String(d.getFullYear());
  return `${dd}.${mm}.${yyyy}`;
}

function hasContent(e?: SiteEvent): boolean {
  if (!e) return false;
  return !!(loc(e.title, lang) || e.date || loc(e.venue, lang));
}

const showUpcoming = hasContent(upcoming);
const showPast = hasContent(pastRecent);
const showStrip = showUpcoming || showPast;

type Kind = 'upcoming' | 'past';

const items: Array<{ kind: Kind; ev: SiteEvent }> = [];
if (showPast && pastRecent) items.push({ kind: 'past', ev: pastRecent });
if (showUpcoming && upcoming) items.push({ kind: 'upcoming', ev: upcoming });
---

{showStrip && (
  <aside class="event-notice" aria-label={labels[lang].region}>
    <div class="event-notice-inner">
      {items.map(({ kind, ev }) => {
        const title = loc(ev.title, lang);
        const venue = loc(ev.venue, lang);
        const date = fmtDate(ev.date);
        const linkProps = ev.link
          ? { href: ev.link, target: '_blank' as const, rel: 'noreferrer' }
          : null;
        const content = (
          <>
            <span class="evt-dot" aria-hidden="true"></span>
            <span class="evt-label">{kind === 'upcoming' ? labels[lang].upcoming : labels[lang].past}</span>
            {title && <span class="evt-title">{title}</span>}
            {venue && <span class="evt-venue">{venue}</span>}
            {date && <span class="evt-date">{date}</span>}
          </>
        );
        return linkProps ? (
          <a class={`evt evt-${kind}`} {...linkProps}>{content}</a>
        ) : (
          <div class={`evt evt-${kind}`}>{content}</div>
        );
      })}
    </div>
  </aside>
)}
