---
// Self-contained holding page (full HTML doc). Used by every route on the
// holding-page branch so each path ships an actual file — important because
// the bare `_redirects` catch-all wasn't enough to evict CF Pages' internal
// per-path cache for paths that physically existed in earlier deployments.
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dália Cordeiro · Em renovação / Coming soon</title>
    <meta name="description" content="Site em renovação. Voltamos em breve. — Site under renovation. Back soon." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#efe7d6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/newsreader-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/intertight-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face {
        font-family: 'Newsreader';
        src: url('/fonts/newsreader-normal-latin.woff2') format('woff2');
        font-weight: 400; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Inter Tight';
        src: url('/fonts/intertight-normal-latin.woff2') format('woff2');
        font-weight: 400; font-style: normal; font-display: swap;
      }
      :root {
        --paper: #efe7d6;
        --ink: #1f1b16;
        --ink-soft: #4a4238;
        --line: rgba(31, 27, 22, 0.16);
        --accent: #b84e3a;
        --serif: 'Newsreader', 'Times New Roman', serif;
        --sans: 'Inter Tight', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.6;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        -webkit-font-smoothing: antialiased;
      }
      main { max-width: 520px; text-align: center; }
      .brand {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(36px, 7vw, 56px);
        letter-spacing: -0.01em;
        margin: 0 0 3rem;
        color: var(--ink);
      }
      .brand em { color: var(--accent); font-style: italic; font-weight: 400; }
      .lang-block { padding: 1.25rem 0; }
      .lang-block .label {
        font-family: var(--sans);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--ink-soft);
        margin: 0 0 0.5rem;
      }
      .lang-block p {
        font-family: var(--serif);
        font-size: clamp(18px, 3vw, 22px);
        font-style: italic;
        line-height: 1.4;
        color: var(--ink);
        margin: 0;
      }
      .sep {
        border: 0;
        border-top: 1px solid var(--line);
        max-width: 60px;
        margin: 1rem auto;
      }
      .footer {
        margin-top: 3rem;
        font-size: 13px;
        color: var(--ink-soft);
        letter-spacing: 0.04em;
      }
      .footer a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
        padding-bottom: 1px;
      }
      .footer a:hover { opacity: 0.75; }
    </style>
  </head>
  <body>
    <main>
      <h1 class="brand">Dália <em>Cordeiro</em></h1>

      <div class="lang-block">
        <p class="label">PT</p>
        <p>Site em renovação.<br />Voltamos em breve.</p>
      </div>

      <hr class="sep" aria-hidden="true" />

      <div class="lang-block">
        <p class="label">EN</p>
        <p>Site under renovation.<br />Back soon.</p>
      </div>

      <p class="footer">
        <a href="https://www.instagram.com/dalia_cordeiro_art/" target="_blank" rel="noreferrer">@dalia_cordeiro_art</a>
      </p>
    </main>
  </body>
</html>
