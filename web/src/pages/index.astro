---
// Root redirect: default to /en/, redirect to /pt/ only if browser language is PT.
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Dália Cordeiro · Art</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta http-equiv="refresh" content="0;url=/en/" />
    <script is:inline>
      const lang = (navigator.language || '').slice(0, 2);
      if (lang === 'pt') window.location.replace('/pt/');
    </script>
  </head>
  <body></body>
</html>
