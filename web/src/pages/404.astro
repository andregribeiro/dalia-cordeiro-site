---
import '../styles/global.css';
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Dália Cordeiro</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#efe7d6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/newsreader-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/intertight-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="theme-paper accent-coral">
    <main class="not-found">
      <p class="num">404</p>

      <div class="lang-block">
        <h2>Página <em>não encontrada</em></h2>
        <p>A obra que procura não está aqui.</p>
        <p><a href="/pt/">Voltar à galeria</a></p>
      </div>

      <hr class="sep" aria-hidden="true" />

      <div class="lang-block">
        <h2>Page <em>not found</em></h2>
        <p>The work you're looking for isn't here.</p>
        <p><a href="/en/">Back to the gallery</a></p>
      </div>
    </main>

    <style>
      .not-found {
        position: relative;
        z-index: 10;
        max-width: 560px;
        margin: 0 auto;
        padding: 8rem 2rem 4rem;
        text-align: center;
      }
      .not-found .num {
        font-family: var(--serif);
        font-size: clamp(80px, 18vw, 140px);
        font-weight: 300;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--accent);
        margin: 0 0 2rem;
      }
      .not-found .lang-block { padding: 1.25rem 0; }
      .not-found h2 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 28px;
        margin: 0 0 0.5rem;
        color: var(--ink);
      }
      .not-found h2 em { color: var(--accent); font-style: italic; }
      .not-found p { color: var(--ink-soft); margin: 0 0 0.75rem; }
      .not-found a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
        padding-bottom: 1px;
      }
      .not-found a:hover { opacity: 0.75; }
      .not-found .sep {
        border: 0;
        border-top: 1px solid var(--line);
        max-width: 80px;
        margin: 1rem auto;
      }
    </style>
  </body>
</html>
