---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import EventNotice from '../../components/EventNotice.astro';
import Footer from '../../components/Footer.astro';
import { client } from '../../lib/sanity';
import { siteSettingsQuery } from '../../lib/queries';
import type { SiteSettings } from '../../lib/types';

const lang = 'en' as const;
const settings = await client.fetch<SiteSettings>(siteSettingsQuery);

const description = 'Copyright and reservation of rights against artificial intelligence training — Dália Cordeiro.';
---

<Base lang={lang} title="Terms · Dália Cordeiro · Art" description={description}>
  <Header lang={lang} instagramUrl={settings?.instagramUrl} />
  <EventNotice lang={lang} upcoming={settings?.upcomingEvent} pastRecent={settings?.recentPastEvent} />

  <section class="legal">
    <h1>Terms and <em>copyright</em></h1>
    <p class="legal-sub">Last updated: 6 May 2026</p>

    <h2>Copyright</h2>
    <p>
      All text, images, artworks and visual materials published on
      <strong>daliacordeiro.art</strong> are the exclusive property of the
      artist Dália Cordeiro and are protected under Portuguese and European
      Union copyright law (Portuguese Copyright Code; Directive (EU) 2019/790).
    </p>
    <p>
      Any reproduction, publication or use of the works, in whole or in part,
      requires the artist's prior written authorisation.
    </p>

    <h2>Reservation of rights for text and data mining</h2>
    <p>
      Pursuant to <strong>Article 4(3) of Directive (EU) 2019/790</strong>, the
      artist expressly reserves the rights of reproduction and extraction over
      all works published on this site. Accordingly, the use of this artist's
      works is expressly prohibited for:
    </p>
    <ul>
      <li>
        Training, fine-tuning or evaluation of generative artificial
        intelligence models, including diffusion models, multimodal language
        models and any systems that learn visual representations from the
        works;
      </li>
      <li>
        Automated collection (scraping) by systems, agents or crawlers whose
        purpose is to feed the training of generative models;
      </li>
      <li>
        Any form of text and data mining (TDM) for the purposes of training
        generative AI.
      </li>
    </ul>
    <p>
      This reservation is declared in machine-readable form via:
    </p>
    <ul>
      <li><code>robots.txt</code> with explicit blocking of known training bots;</li>
      <li>
        <code>noai</code>, <code>noimageai</code>, <code>tdm-reservation</code>
        and <code>tdm-policy</code> meta tags on every page;
      </li>
      <li>
        HTTP header <code>X-Robots-Tag: noai, noimageai</code> served on this
        site's responses.
      </li>
    </ul>
    <p>
      This reservation remains valid and effective regardless of any third
      party's knowledge, respect or implementation of the technical signals.
    </p>

    <h2>Licensing requests</h2>
    <p>
      For any licensing request, use authorisation, inclusion in an exhibition,
      editorial publication or acquisition of an artwork, please contact directly:
      <a href="mailto:studio@daliacordeiro.art">studio@daliacordeiro.art</a>.
    </p>

    <h2>Updates</h2>
    <p>
      These terms may be updated from time to time. The current version is
      always available at <a href="/en/terms">daliacordeiro.art/en/terms</a>.
    </p>
  </section>

  <Footer lang={lang} footerText={settings?.footerText} instagramUrl={settings?.instagramUrl} />
</Base>
