---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import EventNotice from '../../components/EventNotice.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import WorkGrid from '../../components/WorkGrid';
import { client, urlFor } from '../../lib/sanity';
import { siteSettingsQuery, allArtworksQuery } from '../../lib/queries';
import type { SiteSettings, Artwork } from '../../lib/types';
import { loc } from '../../lib/helpers';
import { personJsonLd, websiteJsonLd } from '../../lib/seo';

const lang = 'pt' as const;

const settings = await client.fetch<SiteSettings>(siteSettingsQuery);
const artworks = await client.fetch<Artwork[]>(allArtworksQuery);

const description = 'Pintora — Porto, Portugal';

const seoSrc = settings?.defaultSeoImage ?? settings?.heroArtwork?.image;
const ogImage = seoSrc ? urlFor(seoSrc).width(1200).auto('format').url() : undefined;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = [websiteJsonLd(lang, siteUrl), personJsonLd(lang, siteUrl, ogImage)];

// Pre-compute image URLs server-side (card thumbnails)
const imageUrls: Record<string, string> = {};
for (const aw of artworks) {
  imageUrls[aw._id] = urlFor(aw.image).width(600).auto('format').url();
}
---

<Base lang={lang} title="Dália Cordeiro · Art" description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <Header lang={lang} active="works" instagramUrl={settings?.instagramUrl} />
  <EventNotice lang={lang} upcoming={settings?.upcomingEvent} pastRecent={settings?.recentPastEvent} />
  <Hero
    lang={lang}
    headline={settings?.heroHeadline}
    intro={settings?.heroIntro}
    featured={settings?.heroArtwork}
  />
  <WorkGrid
    client:load
    lang={lang}
    artworks={artworks}
    imageUrls={imageUrls}
    sectionTitle="<em>Obras</em>, 2022 — 2026"
    contactUrl="/pt/contacto"
  />
  <Footer lang={lang} footerText={settings?.footerText} instagramUrl={settings?.instagramUrl} />
</Base>
